DATA_PATH=
TIMEZONE=

# zookeeper
ZOOKEEPER_IMAGE=
ZOOKEEPER_PORT=

# redis
REDIS_IMAGE=
REDIS_DB=
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# POSTGRES_HOST default: localhost, for `init_db.sh` to connect
POSTGRES_HOST=
# POSTGRES_PORT default: 5432
POSTGRES_PORT=

# MongoDB
MONGO_INITDB_DATABASE=
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_PORT=

# Kafka
KAFKA_CLUSTER_ID=

# RocketMQ
ROCKETMQ_NAMESRV_PORT=
ROCKETMQ_BROKER_PORT1=
ROCKETMQ_BROKER_PORT2=

# Nginx
NGINX_IMAGE=
NGINX_PORT=

# Elasticsearch
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTICSEARCH_SERVICEACCOUNT_TOKEN=
ES_PORT1=
ES_PORT2=

# ClickHouse
# CLICKHOUSE_HOST default: localhost
CLICKHOUSE_HOST=
# CLICKHOUSE_PORT default: 8123
CLICKHOUSE_PORT=
# CLICKHOUSE_PORT_NATIVE default: 9000
CLICKHOUSE_PORT_NATIVE=
# CLICKHOUSE_USER default: default
CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD default: (empty)
CLICKHOUSE_PASSWORD=

# Vector Database
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT1=
MINIO_PORT2=
MINIO_BUCKET_NAME=
MILVUS_PORT1=
MILVUS_PORT2=

# Gateway <-> service trust token (gateway signs, factory-service validates).
# Both containers must see the same value. Default in compose:
# mwt-internal-secret-2024 (dev only, override in a real deployment).
INTERNAL_TOKEN_SECRET=
# Prod datasource for the digital-twin stack (prod profile only).
# Defaults in compose: jdbc:postgresql://postgres:5432/metawebthree,
# user/password from POSTGRES_USER / POSTGRES_PASSWORD, library created by
# sql/init_db.sh. Override here for a real deployment; dev is unaffected.
DATASOURCE_URL=
