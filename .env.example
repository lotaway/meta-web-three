DATA_PATH=
TIMEZONE=

# zookeeper
ZOOKEEPER_IMAGE=
ZOOKEEPER_PORT=

# redis
REDIS_IMAGE=
REDIS_DB=
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# POSTGRES_HOST default: localhost, for `init_db.sh` to connect
POSTGRES_HOST=
# POSTGRES_PORT default: 5432
POSTGRES_PORT=

# MongoDB
MONGO_INITDB_DATABASE=
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_PORT=

# Kafka
KAFKA_CLUSTER_ID=
# Bridge-network Java services (e.g. factory-service in the digital-twin
# stack) reach the host-network broker through this bootstrap address.
# Leave empty to use the default host.docker.internal:9094 (the broker's
# PLAINTEXT_DOCKER listener); set an explicit address only for a remote broker.
KAFKA_BOOTSTRAP_SERVERS=
# Port for the broker's PLAINTEXT_DOCKER listener, advertised as
# host.docker.internal:<port> to bridge-network clients. Default: 9094.
KAFKA_BRIDGE_PORT=

# InfluxDB time-series telemetry (digital-twin stack, opt-in).
# Leave INFLUX_ENABLED empty to use the relational store only. When enabling,
# INFLUX_TOKEN must match the admin token the InfluxDB container is setup with.
INFLUX_ENABLED=
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_USERNAME=
INFLUX_PASSWORD=

# MQTT telemetry ingestion (digital-twin stack, opt-in). Left empty = disabled,
# no telemetry flows. Broker is a local compose service by default; set to a real
# field broker for production. Topic prefix is the single source for both the
# subscriber and the telemetry mapping. Test data is published only by the
# explicit scripts/test-mqtt-telemetry.* tool, never automatically.
MQTT_ENABLED=
MQTT_BROKER_URL=
MQTT_TOPIC_PREFIX=
MQTT_PORT=

# RocketMQ
ROCKETMQ_NAMESRV_PORT=
ROCKETMQ_BROKER_PORT1=
ROCKETMQ_BROKER_PORT2=

# Nginx
NGINX_IMAGE=
NGINX_PORT=

# Elasticsearch
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTICSEARCH_SERVICEACCOUNT_TOKEN=
ES_PORT1=
ES_PORT2=

# ClickHouse
# CLICKHOUSE_HOST default: localhost
CLICKHOUSE_HOST=
# CLICKHOUSE_PORT default: 8123
CLICKHOUSE_PORT=
# CLICKHOUSE_PORT_NATIVE default: 9000
CLICKHOUSE_PORT_NATIVE=
# CLICKHOUSE_USER default: default
CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD default: (empty)
CLICKHOUSE_PASSWORD=

# Vector Database
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT1=
MINIO_PORT2=
MINIO_BUCKET_NAME=
MILVUS_PORT1=
MILVUS_PORT2=

# Gateway <-> service trust token (gateway signs, downstream services validate).
# All services must see the SAME value. The compose files and application-common.yml
# provide a dev-only default (mwt-internal-secret-2024); override it here for real
# deployments and use a secret manager in production.
INTERNAL_TOKEN_SECRET=
# Prod datasource for the digital-twin stack (prod profile only).
# Defaults in compose: jdbc:postgresql://postgres:5432/metawebthree,
# user/password from POSTGRES_USER / POSTGRES_PASSWORD, library created by
# sql/init_db.sh. Override here for a real deployment; dev is unaffected.
DATASOURCE_URL=

# ---------------------------------------------------------------------------
# Blockchain / virtual-asset features (OPTIONAL, OFF by default)
# ---------------------------------------------------------------------------
# Normal fiat commerce does not need any of these. Leave them empty to keep
# Solana/token/NFT/marketplace endpoints disabled and hidden in backstage-admin
# (frontend switch: VITE_BLOCKCHAIN_ENABLED, also defaults to false).
# Set BLOCKCHAIN_SOLANA_ENABLED=true only on deployments that opt in.
BLOCKCHAIN_SOLANA_ENABLED=
SOLANA_RPC_URL=
# Private key encryption for managed Solana wallets (64-char hex). Optional.
SOLANA_ENCRYPTION_KEY=

# Deployed Anchor program id (defaults to declare_id! in contracts/solana/lib.rs).
# Only override when running a different program deployment.
SOLANA_PROGRAM_ID=
# Default payment mint used by activities / marketplace (wrapped SOL by default).
SOLANA_PAYMENT_MINT=
# Default activity reward split in basis points [1st, 2nd, 3rd] (50/30/20).
SOLANA_ACTIVITY_DEFAULT_REWARD_PERCENTAGES=
# SPL / Metaplex / System programs and Rent sysvar. Only override on non-standard
# clusters (e.g. local validator with rebuilt programs).
SOLANA_TOKEN_PROGRAM_ID=
SOLANA_ASSOCIATED_TOKEN_PROGRAM_ID=
SOLANA_TOKEN_METADATA_PROGRAM_ID=
SOLANA_SYSTEM_PROGRAM_ID=
SOLANA_RENT_SYSVAR_ID=
