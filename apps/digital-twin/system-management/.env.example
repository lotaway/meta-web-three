# Desktop app
APP_PROTOCOL= # default: meta-note
WEBSOCKET_PORT= # default: 5050
WEB_SERVER_PORT= # default: 5051
DEV_SERVER_PORT= # default: 5173
WINDOW_WIDTH= # default: 1200
WINDOW_HEIGHT= # default: 800
NODE_ENV= # default: production
PROXY_URL= # optional, for external chat sites
LOCAL_API_TOKEN= # optional; when unset a random per-session token is generated for the local HTTP API
DEEPSEEK_SESSION_COOKIE_NAME= # default: ds_session_token

# Voice and transcription services
VITE_VOICE_API_URL= # default: http://localhost:5051
WHISPER_URL= # default: http://localhost:8080/v1/audio/transcriptions
WHISPER_MODEL= # default: whisper-1

# LLM providers
LOCAL_LLM_PROVIDER= # optional, e.g. http://localhost:11434 (Ollama)

# Kafka and Redis for the study queue
KAFKA_BROKER= # default: localhost:9092
REDIS_HOST= # default: localhost
REDIS_PORT= # default: 6379
REDIS_PASSWORD= # optional
STUDY_LIST_LIMIT_COUNT= # default: 10
STUDY_LIMIT_TIME= # default: 45 (minutes)

# Digital twin services
VITE_DIGITAL_TWIN_API_HOST= # default: localhost
VITE_DIGITAL_TWIN_API_PORT= # default: 10101
VITE_DIGITAL_TWIN_API_URL= # optional full URL override
VITE_DIGITAL_TWIN_WS_URL= # optional full WebSocket URL override
VITE_MES_API_HOST= # default: localhost
VITE_MES_API_PORT= # default: 8080
VITE_MES_API_URL= # optional full URL override
