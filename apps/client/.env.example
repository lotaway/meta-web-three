# ==================== Backend API ====================
# 后端网关（gateway）监听端口为 10081，见 scripts/server-services-registry.sh。
# 网关开启 Spring Cloud Gateway discovery locator，请求路径需带 /{serviceId} 前缀
# （如 /mall-catalog-service/product/list），serviceId 映射见 apps/backstage-admin/src/utils/http.ts。

# OpenAPI 文档地址：openapi-generator 生成 src/generated/api 时从此地址拉取聚合文档
# （网关聚合入口：{host}/meta/v3/api-docs）
NEXT_PUBLIC_BACK_API_DOC_HOST=http://localhost:10081 # backend openapi doc

# 后端接口地址（web / 构建工具链使用；留空时按 10081 端口自动推导）
NEXT_PUBLIC_BACK_API_HOST= # backend api host

# RN App backend gateway address. Metro only inlines EXPO_PUBLIC_* variables (NEXT_PUBLIC_* only applies to web).
# When empty, it is derived automatically: reads hostUri from the Expo dev server -> Android emulator falls back to 10.0.2.2, iOS simulator falls back to localhost.
# Android emulator: set EXPO_PUBLIC_BACK_API_HOST=http://10.0.2.2:10081
# 真机 / 其他设备: set EXPO_PUBLIC_BACK_API_HOST=http://192.168.1.110:10081
EXPO_PUBLIC_BACK_API_HOST=
BACKEND_API_ROOT_DIR= # backend java program root directory
CONTRACT_ROOT_DIR=../evm-contract # contract program root directory

# ==================== iOS Certificate ====================
CN=
Orginazation=
OrganizationalUnit=
City=
Province=
CountryCode=

EXPO_PUBLIC_PASSKEY_ENABLED= #default=false
# Relying Party ID — must exactly match the domain configured in the backend and in the iOS Associated Domains.
# Use "localhost" for local development and the real domain (e.g. example.com) for production.
EXPO_PUBLIC_PASSKEY_RP_ID=localhost
EXPO_PUBLIC_DEFAULT_USER_ID=1
EXPO_PUBLIC_WECHAT_APP_ID=
EXPO_PUBLIC_ALIPAY_APP_ID=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
